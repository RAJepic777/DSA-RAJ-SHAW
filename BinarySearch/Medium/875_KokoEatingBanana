class Solution {    
    public int minEatingSpeed(int[] piles, int h) {
        int start=1;
        int end=0;
        for(int x:piles){
            end=Math.max(end,x);
        }

        int ans=-1;
        while(start<=end){
           int mid=start+(end-start)/2;
           long cal=check(piles,mid);
           if(cal<=h){
                ans=mid;
                end=mid-1;
            }else{
                start=mid+1;
            }
        }
        return ans;       
    }
    public long check(int []nums,int mid){
        long ans=0;
        for(int x:nums){
            ans=ans+(long)Math.ceil((double)x/mid);
        }
        return ans;
    }

}
