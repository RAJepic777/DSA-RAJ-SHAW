class Solution {
    int maxIndexDiff(int[] arr) {
        // code here
        int n=arr.length;
        int []rightMax= new int[n];
        rightMax[n-1]=arr[n-1];
        
        for(int i=n-2;i>=0;i--){
            rightMax[i]=Math.max(rightMax[i+1],arr[i]);
        }
        int i=0;
        int j=0;
        int maxDiff=0;
        while(i<n && j<n){
            if(rightMax[j]>=arr[i]){
                maxDiff=Math.max(maxDiff,j-i);
                j++;
            }else{
                i++;
            }
        }
        return maxDiff;
    }
}
